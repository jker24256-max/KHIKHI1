import java.util.*;
class largest
{
    Scanner sc=new Scanner(System.in);
    int max =0,i;
    int arr[]=new int[5];
    for(i=0;i<5;i++)
    {
        System.out.println("Enter the number");
        arr[i]=sc.nextInt();
    }
    max=arr[0];
    for(i=1;i<5;i++)
    {
        if(arr[i]>max)
        {
            max=arr[i];
        }
    }
    System.out.println("The largest number is: "+max);
}